<mvc:XMLView
    xmlns:form="sap.ui.layout.form"
    controllerName="fioriui5app.controller.RRDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons"
    class="d-flex justify-content-center"
>
    <Page
        id="rrd"
        title="{i18n>rrdashboard}"
        showNavButton="false"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <form:SimpleForm>
            <form:content>
                <VBox
                    height="100%"
                    fitContainer="true"
                >
                    <HBox
                        width="100%"
                        justifyContent="SpaceAround"
                    >
                        <VBox>
                            <Label
                                text="{i18n>invoicedate}"
                                class="sapUiTinyMarginBottom"
                            />
                            <HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                            >
                                <DatePicker
                                    id="invoiceStartDate"
                                    value="{EntryFormDataSourceModel>/invoicefromdate}"
                                    displayFormat="dd-MM-yyyy"
                                    valueFormat="dd-MM-yyyy"
                                    change="handleInvoiceFromDateChange"
                                    placeholder="From"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                />
                                <DatePicker
                                    id="invoiceEndDate"
                                    value="{EntryFormDataSourceModel>/invoicetodate}"
                                    displayFormat="dd-MM-yyyy"
                                    valueFormat="dd-MM-yyyy"
                                    change="handleInvoiceToDateChange"
                                    placeholder="To"
                                    class="sapUiTinyMarginBegin sapUiTinyMarginBottom"
                                />
                            </HBox>
                        </VBox>

                        <VBox>
                            <Label
                                text="{i18n>customer}"
                                class="sapUiTinyMarginBottom"
                                required="true"
                            />
                            <HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                            >
                                <Input
                                    id="customer"
                                    type="Text"
                                    value="{EntryFormDataSourceModel>/customername}"
                                    placeholder="Customer Name"
                                    showValueHelp="true"
                                    valueHelpRequest="cflForCustomer"
                                    liveChange="onLiveChange"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                />
                                <Input
                                    id="inptCustomerCode"
                                    type="Text"
                                    value="{EntryFormDataSourceModel>/customercode}"
                                    placeholder="Customer Code"
                                    editable="false"
                                    class="sapUiTinyMarginBegin sapUiTinyMarginBottom"
                                />
                            </HBox>
                        </VBox>

                        <VBox>
                            <Label
                                text="{i18n>salesorder}"
                                class="sapUiTinyMarginBottom"
                                required="true"
                            />
                            <HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                            >
                                <Input
                                    id="SalesOrderr"
                                    type="Text"
                                    value="{EntryFormDataSourceModel>/salesorder}"
                                    placeholder="Sales Order"
                                    showValueHelp="true"
                                    valueHelpRequest="cflForSalesOrder"
                                    required="true"
                                    liveChange="onLiveChange"
                                    class="sapUiTinyMarginBottom"
                                />
                            </HBox>
                        </VBox>
                    </HBox>
                    <HBox justifyContent="Center">
                        <Button
                            type="Emphasized"
                            text="{i18n>btnFetchData}"
                            press="onBtnFetchDataAction"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            text="{i18n>btnReset}"
                            press="onBtnResetAction"
                            class="sapUiTinyMargin"
                        />
                    </HBox>

