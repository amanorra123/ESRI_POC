                    <form:SimpleForm>
                        <form:content>
                            <ScrollContainer
                                id="scrollContainerRRD"
                                width="100%"
                                height="auto"
                                horizontal="true"
                                vertical="true"
                                class="sapUiTinyMarginBottom sapUiSmallMarginTop"
                            >
                                <Table
                                    id="RRDTable_EntryForm"
                                    items="{ path: 'EntryFormDataSourceModel>/value'}"
                                    sticky="ColumnHeaders,HeaderToolbar"
                                    growing="true"
                                    growingThreshold="20"
                                    growingScrollToLoad="true"
                                >
                                    <headerToolbar />
                                    <columns>
                                        <Column width="30px">
                                            <header>
                                                <Label text="{i18n>srno}" />
                                            </header>
                                        </Column>
                                        <Column width="60px">
                                            <header>
                                                <Label
                                                    text="{i18n>salesorder}"
                                                />
                                            </header>
                                        </Column>

                                        <Column width="60px">
                                            <header>
                                                <Label
                                                    text="{i18n>billingdocument}"
                                                />
                                            </header>
                                        </Column>
                                        <Column width="50px">
                                            <header>
                                                <Label
                                                    text="{i18n>billingdate}"
                                                    wrapping="true"
                                                />
                                            </header>
                                        </Column>

                                        <Column width="50px">
                                            <header>
                                                <Label
                                                    text="{i18n>billingvalue}"
                                                    wrapping="true"
                                                />
                                            </header>
                                        </Column>
                                        <Column width="60px">
                                            <header>
                                                <Label
                                                    text="{i18n>period}"
                                                    wrapping="true"
                                                />
                                            </header>
                                        </Column>
                                        <Column width="60px">
                                            <header>
                                                <Label
                                                    text="{i18n>proposedrr}"
                                                    wrapping="true"
                                                />
                                            </header>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <Text
                                                    text="{EntryFormDataSourceModel>RowNumber}"
                                                    wrapping="true"
                                                />

                                                <Text
                                                    text="{EntryFormDataSourceModel>SalesOrder}"
                                                    wrapping="true"
                                                />

                                                <Text
                                                    text="{EntryFormDataSourceModel>BillingDocument}"
                                                    wrapping="true"
                                                />
                                                <Text
                                                    text="{EntryFormDataSourceModel>BillingDate}"
                                                    wrapping="true"
                                                />
                                                <Text
                                                    text="{EntryFormDataSourceModel>BillValue}"
                                                    wrapping="true"
                                                />
                                                <Input
                                                    id="inptPeriod"
                                                    type="Number"
                                                    value="{EntryFormDataSourceModel>Period}"
                                                    placeholder="Period"
                                                />
                                                <Input
                                                    id="inptproposedrr"
                                                    type="Number"
                                                    value="{EntryFormDataSourceModel>RRAmount}"
                                                    placeholder="Proposed RR"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </ScrollContainer>
                        </form:content>
                    </form:SimpleForm>

                    <HBox
                        width="100%"
                        justifyContent="Center"
                    >
                        <Button
                            id="btnExecute"
                            type="Emphasized"
                            text="{i18n>btnexecute}"
                            press="onBtnExecutionAction"
                        />
                    </HBox>
                </VBox>
            </form:content>
        </form:SimpleForm>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <FlexBox justifyContent="End">
                    <!-- <Button
                        type="Emphasized"
                        text="{i18n>SAVE}"
                        press="onSave"
                    /> -->
                </FlexBox>
            </Toolbar>
        </footer>
    </Page>
</mvc:XMLView>
