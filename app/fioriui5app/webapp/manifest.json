{
  "_version": "1.65.0",
  "sap.app": {
    "id": "fioriui5app",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.6",
      "toolsId": "6b8bd47f-66b0-4bcc-9ffd-602d55b46ce7"
    },
    "crossNavigation": {
      "inbounds": {
        "Dashbaord-display": {
          "semanticObject": "Dashbaord",
          "action": "display",
          "title": "{{Dashbaord-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fioriui5app.i18n.i18n"
        }
      },
      "BillingDataModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/BillingDataModel.json",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "CustomersDataModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/CustomersDataModel.json",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "SalesOrdersDataModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/SalesOrdersDataModel.json",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "fioriui5app.view",
        "async": true,
        "viewPath": "fioriui5app.view"
      },
      "routes": [
        {
          "name": "RouteRRDashboard",
          "pattern": ":?query:",
          "target": [
            "TargetRRDashboard"
          ]
        }
      ],
      "targets": {
        "TargetRRDashboard": {
          "id": "RRDashboard",
          "name": "RRDashboard"
        }
      }
    },
    "rootView": {
      "viewName": "fioriui5app.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "fioriui5app"
  }
}